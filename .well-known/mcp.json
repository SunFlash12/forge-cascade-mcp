{
  "name": "Froggit MCP Connector",
  "slug": "forge-cascade-mcp-memory-server",
  "description": "Public docs and links for Froggit; not the memory server (hosted MCP: froggit.ai/mcp).",
  "repository": "https://github.com/SunFlash12/forge-cascade-mcp",
  "homepage": "https://froggit.ai/",
  "documentation": "https://froggit.ai/docs/agents",
  "api_reference": "https://froggit.ai/openapi.json",
  "manifest": "https://froggit.ai/.well-known/mcp.json",
  "server_card": "https://raw.githubusercontent.com/SunFlash12/forge-cascade-mcp/main/.well-known/mcp/server-card.json",
  "well_known_server_json": "https://raw.githubusercontent.com/SunFlash12/forge-cascade-mcp/main/.well-known/mcp/server.json",
  "smithery_config": "https://raw.githubusercontent.com/SunFlash12/forge-cascade-mcp/main/smithery.yaml",
  "offers": "https://froggit.ai/offers.json",
  "category": "RAG & Knowledge",
  "language": "Python",
  "transport": "stdio",
  "license": "MIT",
  "package": {
    "name": "ghcr.io/sunflash12/forge-cascade-mcp",
    "type": "docker"
  },
  "install": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/SunFlash12/forge-cascade-mcp.git",
      "forge-cascade-mcp"
    ]
  },
  "capabilities": {
    "tools": [
      "forge_buyer_routes",
      "forge_checkout_links",
      "forge_paid_route_for_context"
    ],
    "resources": [
      "forge://buyer-routes"
    ],
    "prompts": [
      "assess_mcp_memory_fit"
    ]
  },
  "contact": "https://froggit.ai/contact"
}
